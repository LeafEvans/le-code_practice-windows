/** Begin define meta data for sub error code */
export enum LynxErrorLevel {
	Fatal = "fatal",
	Error = "error",
	Warn = "warn",
	Undecided = "undecided"
}

export enum LynxErrorConsumer {
	FrontEnd = "front-end",
	Client = "client",
	Lynx = "lynx"
}

/** End define meta data for sub error code */

export class LynxErrorMetaData {
	public readonly level: LynxErrorLevel;
	public readonly fixSuggestion: string;
	public readonly consumer: Array<LynxErrorConsumer>;

	constructor(level: LynxErrorLevel, fixSuggestion: string, consumer: Array<LynxErrorConsumer>) {
		this.level = level;
		this.fixSuggestion = fixSuggestion;
		this.consumer = consumer;
	}

	public static getMetaData(subCode: number): LynxErrorMetaData | null {
		switch (subCode) {
			case LynxSubErrorCode.E_SUCCESS:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "", []);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_RENDER_FAILED:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Should not call `loadTemplate` while the rendering pipeline of app bundle has not finished", []);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_ENV_NOT_READY:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please call the initialization method of LynxEnv before loadTemplate.", [LynxErrorConsumer.Client]);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_BAD_RESPONSE:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check if the app bundle is available", []);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_PARSE_FAILED:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check that 1. the provided bundle is an app bundle, 2. the engine version of the bundle is compatible with that of Lynx engine, 3. the bundle file is not broken.", []);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_BAD_BUNDLE:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check the error message of the bundle.", []);
			case LynxSubErrorCode.E_APP_BUNDLE_LOAD_EXCEPTION:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "", []);
			case LynxSubErrorCode.E_APP_BUNDLE_RELOAD_EARLY_RELOAD:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please `loadTemplate` before `reloadTemplate`", [LynxErrorConsumer.Client]);
			case LynxSubErrorCode.E_APP_BUNDLE_VERIFY_INVALID_SIGNATURE:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check if the app bundle has been signed correctly", []);
			case LynxSubErrorCode.E_BTS_RUNTIME_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Undecided, "", []);
			case LynxSubErrorCode.E_BTS_RUNTIME_ERROR_SCRIPT_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check the error message and fix the script.", []);
			case LynxSubErrorCode.E_BTS_RUNTIME_ERROR_BYTECODE_SCRIPT_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Fatal, "Please check the error message and fix the script.", []);
			case LynxSubErrorCode.E_BTS_RUNTIME_ERROR_BINDINGS_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check the error message and fix binding API call.", []);
			case LynxSubErrorCode.E_BTS_RUNTIME_ERROR_EXECUTE_TIMEOUT_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Warn, "Please check the error message and fix the script.", []);
			case LynxSubErrorCode.E_BTS_PLATFORM_CALL_JS_FUNCTION_TOO_FREQUENCY:
				return new LynxErrorMetaData(LynxErrorLevel.Warn, "Please throttle related calls.", []);
			case LynxSubErrorCode.E_BTS_LIFECYCLE_LISTENER_ERROR_EXCEPTION:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please see error info.", []);
			case LynxSubErrorCode.E_BTS_JS_CALL_NATIVE_FUNCTION_TOO_FREQUENCY:
				return new LynxErrorMetaData(LynxErrorLevel.Warn, "Please throttle related calls.", []);
			case LynxSubErrorCode.E_RESOURCE_IMAGE_BIG_IMAGE:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please resize the image to appropriate dimensions or enable downsampling.", []);
			case LynxSubErrorCode.E_RESOURCE_IMAGE_PIC_SOURCE:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Possibly due to an unsupported image format or a corrupted file. Please verify the integrity of the image file.", []);
			case LynxSubErrorCode.E_RESOURCE_IMAGE_FROM_USER_OR_DESIGN:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "In most cases, the issue arises from a canceled image request or an unavailable network connection.", []);
			case LynxSubErrorCode.E_RESOURCE_IMAGE_FROM_NETWORK_OR_OTHERS:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please investigate the corresponding image download workflow for potential issues.", []);
			case LynxSubErrorCode.E_RESOURCE_IMAGE_EXCEPTION:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "An unidentified exception occurred that cannot be attributed to a specific cause. Please investigate further based on the available details.", []);
			case LynxSubErrorCode.E_RESOURCE_FONT:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "", []);
			case LynxSubErrorCode.E_RESOURCE_FONT_SRC_FORMAT_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check the font-face format.", []);
			case LynxSubErrorCode.E_RESOURCE_FONT_RESOURCE_LOAD_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check whether font resource is available.", []);
			case LynxSubErrorCode.E_RESOURCE_FONT_BASE64_PARSING_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check whether the base64 resource is available.", []);
			case LynxSubErrorCode.E_RESOURCE_FONT_FILE_FORMAT_NOT_SUPPORTED:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please use a font file in ttf or otf format.", []);
			case LynxSubErrorCode.E_RESOURCE_FONT_REGISTER_FAILED:
				return new LynxErrorMetaData(LynxErrorLevel.Undecided, "If the font is displayed correctly, there is no need to deal with it.", []);
			case LynxSubErrorCode.E_RESOURCE_EXTERNAL_RESOURCE_REQUEST_FAILED:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check whether the url of the external resource is available", []);
			case LynxSubErrorCode.E_RESOURCE_EXTERNAL_RESOURCE_LOCAL_RESOURCE_LOAD_FAIL:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please check whether the local external resource is available", []);
			case LynxSubErrorCode.E_RESOURCE_I18N:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "", []);
			case LynxSubErrorCode.E_RESOURCE_MODULE_PARAMS_ERROR:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please refer to the parameter descriptions of this API in documentation and check the parameters used in the call.", [LynxErrorConsumer.FrontEnd]);
			case LynxSubErrorCode.E_RESOURCE_MODULE_IMG_PREFETCH_HELPER_NOT_EXIST:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please refer to the official documentation to integrate LynxImageService into your app.", [LynxErrorConsumer.Client]);
			case LynxSubErrorCode.E_RESOURCE_MODULE_RESOURCE_SERVICE_NOT_EXIST:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "Please refer to the official documentation to implement the ILynxResourceService and integrate it into your app.", [LynxErrorConsumer.Client]);
			case LynxSubErrorCode.E_RESOURCE_CUSTOM:
				return new LynxErrorMetaData(LynxErrorLevel.Error, "This is unexpected. Please file an issue to Lynx to help address it.", []);
			case LynxSubErrorCode.E_RESOURCE_EXCEPTION:
